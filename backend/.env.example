# Variables de entorno del backend ControlCodmilla
# Uso: exportar en el shell o archivo .env cargado por el orquestador

DB_URL=jdbc:mysql://localhost:3306/PaginaCod?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=false
DB_USER=root
DB_PASS=cambia-esta-clave
DB_POOL_SIZE=10

FILE_UPLOAD_DIR=uploads
JPA_DDL_AUTO=update

# Orígenes permitidos (sitio público + panel CMS), separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Credenciales del panel CMS (cambiar siempre en producción)
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Producción:
# SPRING_PROFILES_ACTIVE=prod
# JPA_DDL_AUTO=validate
# CORS_ORIGINS=https://www.coodmilla.com,https://admin.coodmilla.com
